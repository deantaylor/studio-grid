{
  "author": "Dean Taylor",
  "name": "studio-grid",
  "productName": "studio-grid",
  "description": "multi-sequencer and composer for monome devices (and not).",
  "version": "0.1.2-beta.4",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "electron": "electron .",
    "electron:ni": "STUDIO_GRID_NI=1 electron .",
    "ni:build": "node bridges/ni/build.mjs",
    "ni:bridge": "node bridges/ni/bridge.mjs",
    "dist": "electron-builder -mwl",
    "lint": "eslint . --max-warnings=0",
    "lint:syntax": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check server/*.js && node --check public/*.js && node --check tests/*.test.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:manual": "node --test --test-concurrency=1 tests/manual/*.test.js",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "osc": "^2.4.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "eslint": "^10.0.3"
  },
  "build": {
    "appId": "com.studiogrid.app",
    "productName": "studio-grid",
    "icon": "assets/icon.png",
    "asar": true,
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "fixtures/**/*",
      "node_modules/**/*",
      "package.json",
      "bridges/ni/bridge.mjs"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "bridges/ni/target/packaged/${arch}",
          "to": "ni",
          "filter": [
            "studio-grid-ni",
            "studio-grid-ni-source.tar.gz"
          ]
        }
      ],
      "binaries": [
        "Contents/Resources/ni/studio-grid-ni"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "beforePack": "./electron/package-ni.cjs"
  }
}
