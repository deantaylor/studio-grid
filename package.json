{
  "author": "Dean Taylor",
  "name": "studio-grid",
  "productName": "studio-grid",
  "description": "multi-sequencer and composer for monome devices (and not).",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "electron": "electron .",
    "dist": "electron-builder -mwl"
  },
  "dependencies": {
    "iconoir": "^7.11.0",
    "osc": "^2.4.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.studiogrid.app",
    "productName": "studio-grid",
    "icon": "assets/icon.png",
    "asar": true,
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
