+pub type WindowTarget = tao::event_loop::EventLoopWindowTarget<()>;
+
+pub struct PreviewWindow {
+    window: Rc<Window>,
+    right_position: (u32, u32),
+}
+
+impl PreviewWindow {
+    pub fn new(target: &WindowTarget, (width, height): (u32, u32)) -> Result<Self, String> {
+        let gap = 12;
+        let pair_width = 2 * width + gap;
+        let stacked = target.primary_monitor().is_some_and(|monitor| {
+            monitor.size().to_logical::<u32>(monitor.scale_factor()).width < pair_width
+        });
+        let (size, right_position) = if stacked {
+            ((width, 2 * height + gap), (0, height + gap))
+        } else {
+            ((pair_width, height), (width + gap, 0))
+        };
+        let window = WindowBuilder::new()
+            .with_title("Studio Grid NI Displays")
+            .with_inner_size(tao::dpi::LogicalSize::new(size.0, size.1))
+            .with_background_color((0, 0, 0, 255))
+            .with_resizable(false)
+            .build(target)
+            .map_err(|error| format!("Failed to create preview window: {error}"))?;
+        Ok(Self { window: Rc::new(window), right_position })
+    }
+}
